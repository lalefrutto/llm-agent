# Hermes-3 с увеличенным контекстом для агента «Атлас».
#
# По умолчанию Ollama запускает модели с num_ctx=4096: промпт роутера
# (~2000 токенов) + история треда + факты из памяти + skill не помещались,
# и Ollama молча обрезала НАЧАЛО контекста — то есть системный промпт.
# Через OpenAI-совместимый API num_ctx не передать, поэтому фиксируем его
# в производной модели:
#   ollama create atlas-hermes3-12k -f config/ollama/hermes3-12k.Modelfile
#
# Замер на RTX 4060 8 GB (2026-10-02, генерация 200 токенов):
#   4k  — 4.91 GB, 100% GPU, 48.9 tok/s
#   8k  — 5.41 GB, 100% GPU, 46.7 tok/s
#   12k — 5.92 GB, 100% GPU, 49.5 tok/s   <- выбран
#   16k — 6.76 GB, 87% GPU (часть слоёв на CPU), 36.0 tok/s
FROM hermes3:8b-llama3.1-q4_K_M
PARAMETER num_ctx 12288
